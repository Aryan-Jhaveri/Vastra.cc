# Vastra — environment variables for a self-hosted install.
# Copy to .env and fill in what you use. Everything is optional except where
# noted: with no AI keys at all, the app boots with mocked image generation and
# embeddings so you can click around.

# ── Mocks (default ON for fresh clones; flip to false to use real APIs) ───────
MOCK_AI_IMAGE_GEN=true   # heroImage + tryon return fixture JPEGs
MOCK_EMBEDDINGS=true     # embedText + embedImage return deterministic vectors

# ── Gemini (free AI Studio key) ───────────────────────────────────────────────
# Get one at https://aistudio.google.com/apikey — no billing account needed.
# Used only when GCP_PROJECT_ID is unset.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Vertex AI (optional, your own GCP project) ────────────────────────────────
# When GCP_PROJECT_ID is set, text/vision/embedding/image-gen calls route
# through Vertex and bill to that project. Auth comes from
# GOOGLE_APPLICATION_CREDENTIALS (a service-account JSON path).
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_LOCATION=us-central1
# Image-gen models on Vertex only live at the "global" endpoint.
# GCP_IMAGE_GEN_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ── OpenRouter (optional) ─────────────────────────────────────────────────────
# When set, any model id containing "/" routes through OpenRouter with this
# key. Also funds the default decision provider (ranking + Related).
# OPENROUTER_API_KEY=sk-or-v1-...

# ── Mail (optional) ───────────────────────────────────────────────────────────
# Sign-in links and notifications via Resend. Without it, links are logged.
# RESEND_API_KEY=re_...
# RESEND_FROM_NOREPLY=no-reply@example.com
# RESEND_FROM_SUPPORT=support@example.com

# ── Auth ──────────────────────────────────────────────────────────────────────
WEB_AUTH_PASSWORD=choose_a_strong_password
# Admin fallback bearer auth for scripted admin ops (admin/admin.mjs).
# ADMIN_BEARER_FALLBACK=true

# Only accounts you create can sign in (first admin:
#   docker compose exec closet node src/transport/web/admin/admin.mjs create-admin you@example.com).
# Set true to let anyone who reaches this instance make an account (a household).
ALLOW_SIGNUPS=false

# ── Google sign-in (optional) ─────────────────────────────────────────────────
# The "Continue with Google" button shows only when BOTH values are set.
# Create an OAuth 2.0 Client (type: Web application) in your GCP project and
# register http://localhost:3000/api/auth/google/callback (plus your domain's).
# GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=
# OAUTH_STATE_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── AI models ─────────────────────────────────────────────────────────────────
# Image-in tasks: categorize, tag scan, inspiration, bulk detection
VISION_MODEL=gemini-2.5-flash
# Text-only tasks: suggest, discover. A "vendor/model" id routes through OpenRouter.
TEXT_MODEL=gemini-2.5-flash
# Image generation (try-on, hero image)
IMAGE_GEN_MODEL=gemini-2.5-flash-image
# IMAGE_GEN_MODEL_LITE=
# IMAGE_GEN_MODEL_PRO=
# DETECTION_MODEL=gemini-2.5-flash
# Chat model for the Ask tab.
# AGENT_MODEL=gemini-2.5-flash

# ── Self-hosted models (optional) ─────────────────────────────────────────────
# Any OpenAI-compatible server (Ollama, llama.cpp, vLLM, LM Studio). Point a
# model var at it with a "local/" prefix, e.g. VISION_MODEL=local/qwen3-vl-8b;
# the prefix is stripped before sending. Local calls cost nothing.
# Docker on a Mac can't reach the Apple GPU: run Ollama natively and use
# http://host.docker.internal:11434/v1.
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_TIMEOUT_MS=180000
# OPENAI_COMPAT_MAX_CONCURRENCY=4
# OPENAI_COMPAT_MAX_QUEUE=32

# One server per capability (./install.sh --gpu writes these for the compose
# GPU stack). Each also reads <PREFIX>_TIMEOUT_MS, _MAX_CONCURRENCY, _MAX_QUEUE.
# IMAGE_GEN_MODEL=local/Qwen/Qwen-Image-2.1
# IMAGE_GEN_BASE_URL=http://qwen-image:8091/v1
# IMAGE_GEN_API_KEY=
# IMAGE_GEN_MAX_CONCURRENCY=1
# IMAGE_GEN_MAX_PER_USER=1
# IMAGE_GEN_MAX_REFS=4
# IMAGE_GEN_TIMEOUT_MS=300000
# EMBED_BASE_URL=http://qwen-embed:8002/v1
# EMBED_API_KEY=
# EMBED_REQUEST=messages
# EMBED_INSTRUCTION=Represent the user's input.

# ── Decision provider (ranking + Related) ─────────────────────────────────────
#   openrouter → Jev on OpenRouter, funded by OPENROUTER_API_KEY (default)
#   typesafe   → any TypeSafe-compatible endpoint, e.g. CLM-8B's clm-serve
#   llm        → yes/no questions scored by any chat model
# With none configured, Related sections are hidden and ranking falls back.
# DECISIONS_PROVIDER=openrouter
# DECISIONS_URL=http://localhost:8700/v1/systemone
# DECISIONS_API_KEY=
# DECISIONS_MODEL=local/qwen3-8b
# DECISIONS_MAX_TOKENS=2048
# DECISIONS_TIMEOUT_MS=30000
# DECISIONS_MAX_CONCURRENCY=4

# ── Embeddings ────────────────────────────────────────────────────────────────
TEXT_EMBED_MODEL=gemini-embedding-001
TEXT_EMBED_DIM=1024
# Image embeddings use Vertex multimodalembedding@001 (needs GCP_PROJECT_ID)
# or a local/ model on EMBED_BASE_URL.
IMAGE_EMBED_MODEL=multimodalembedding@001
IMAGE_EMBED_DIM=1408

# ── Feature flags ─────────────────────────────────────────────────────────────
TEXT_EMBED_ENABLED=true
IMAGE_EMBED_ENABLED=true
SUGGEST_PREFILTER_ENABLED=true
DISCOVER_PREFILTER_ENABLED=true
DISCOVER_RETRIEVAL_ENABLED=true
TRYON_PRIMARY_VIEW_ONLY=true
# Ask tab (in-app chat): on whenever a text model is usable.
# CHAT_ENABLED=true
# Shop row + Liked items (Shopify Global Catalog). Shopify must be able to
# fetch your /.well-known/ucp, so only enable on a public host or set UCP_PROFILE_URL.
# SHOP_ROW_ENABLED=true
# UCP_PROFILE_URL=https://shopify.dev/ucp/agent-profiles/examples/2026-08-25/valid-with-capabilities.json

# ── Server ────────────────────────────────────────────────────────────────────
# CLOSET_DATA_DIR=/data          # defaults to ~/.closet
# WEB_PORT=3000
# APP_BASE_URL=https://your-domain.example   # public base URL for share links
# WEB_APP_URL=https://your-domain.example    # public URL in emailed sign-in links (default http://localhost:3000)

# ── Cloudflare tunnel (Docker, optional) ──────────────────────────────────────
# CLOUDFLARE_TUNNEL_TOKEN=
# CLOUDFLARE_METRICS_HOST=cloudflared

# ── Push notifications (web-push / VAPID, optional) ───────────────────────────
# Generate: node -e "const wp=require('web-push');console.log(JSON.stringify(wp.generateVAPIDKeys()))"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:you@example.com   # contact for push services; make setup writes all three

# ── Client IP / proxies ──────────────────────────────────────────────────────
# Which proxies may set the client IP via X-Forwarded-For (rate limits key on it).
# Default: 1 hop on Render / hosted; otherwise only loopback and private-network
# proxies (a local reverse proxy, the cloudflared or Caddy container). Set a hop
# count or addresses for another setup, or false if nothing sits in front.
# TRUST_PROXY=

# ── Orphaned-image cleanup ────────────────────────────────────────────────────
# Monthly: deletes image files nothing references, after 30 days. apply | report | off
# IMAGE_SWEEP=apply
# IMAGE_SWEEP_GRACE_DAYS=30

# ── Nightly encrypted backups (S3-compatible, optional) ───────────────────────
# Keep BACKUP_ENCRYPTION_SECRET somewhere safe outside this server: without it
# a backup can't be restored.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACKUP_ENCRYPTION_SECRET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BACKUP_BUCKET=
# BACKUP_CRON=0 3 * * *
